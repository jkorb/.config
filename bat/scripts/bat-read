#!/bin/zsh
# A centered source reader. bat highlights; less pages; e opens the original.
set -eo pipefail
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bat"

render() {
  local -a terminal_size=($(stty size < /dev/tty))
  local -i columns=${terminal_size[2]:-80}
  (( columns > 0 )) || columns=80
  local -i width=$(( columns < 100 ? columns : 100 ))
  local -i padding=$(( (columns - width) / 2 ))
  local -a syntax=()
  if [[ -n $BAT_READ_LANGUAGE ]]; then
    syntax=(--language "$BAT_READ_LANGUAGE")
  elif [[ ${BAT_READ_SOURCE:e:l} = theme ]] &&
      python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$BAT_READ_SOURCE" 2>/dev/null; then
    # .theme also belongs to btop and cmus, so do not map it globally.
    syntax=(--language JSON)
  fi
  python3 "$config_dir/../glow/scripts/reader-prompt" --header bat
  print
  bat --paging=never --color=always --decorations=always \
    --style=header,numbers --wrap=character --tabs=4 --terminal-width="$width" \
    "${syntax[@]}" -- "$BAT_READ_SOURCE" |
    awk -v padding="$padding" '{ printf "%*s%s\n", padding, "", $0 }'
  print
}

case $1 in
  --edit|--refresh)
    [[ -n $BAT_READ_SOURCE && -n $BAT_READ_RENDERED ]] || exit 1
    [[ $1 != --edit ]] || nvim -- "$BAT_READ_SOURCE"
    render > "$BAT_READ_RENDERED.next"
    cat -- "$BAT_READ_RENDERED.next" > "$BAT_READ_RENDERED"
    exit
    ;;
esac

language=""
if [[ $1 = -l || $1 = --language ]]; then
  [[ $# -ge 3 ]] || { print -u2 'Usage: bat-read [-l LANGUAGE] FILE'; exit 1; }
  language=$2
  shift 2
fi
[[ $1 != -- ]] || shift
if [[ $# != 1 || ! -f $1 ]]; then
  print -u2 'Usage: bat-read [-l LANGUAGE] FILE'
  exit 1
fi

export BAT_READ_SOURCE=${1:a}
export READER_TRAIL=$(python3 "$config_dir/../glow/scripts/reader-prompt" --push "$BAT_READ_SOURCE")
export BAT_READ_LANGUAGE=$language
export BAT_READ_COMMAND=${0:a}
reader_tmp=$(mktemp -d "${TMPDIR:-/tmp}/bat-read.XXXXXX")
trap 'rm -rf -- "$reader_tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export BAT_READ_RENDERED="$reader_tmp/document.ansi"
render > "$BAT_READ_RENDERED"
LESSUTFCHARDEF="${LESSUTFCHARDEF:+$LESSUTFCHARDEF,}E000-F8FF:p" \
less -R -~ -c --header=1 --lesskey-src="$config_dir/lesskeys" \
  --prompt="$(python3 "$config_dir/../glow/scripts/reader-prompt" bat)" -- "$BAT_READ_RENDERED"
