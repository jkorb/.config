#!/usr/bin/python3
import json
import hashlib
import os
import shlex
import subprocess
import sys
from datetime import datetime, timedelta
from email.utils import parseaddr
from pathlib import Path

MU = "/opt/homebrew/bin/mu"
TERMINAL_NOTIFIER = "/opt/homebrew/bin/terminal-notifier"
DEBUG = "--debug" in sys.argv
XDG_CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
ASSETS = Path(XDG_CONFIG_HOME) / "launchd/assets"
OPEN_MAIL = str(Path(XDG_CONFIG_HOME) / "neomutt/scripts/neomutt-notification")


def cache_dir():
    xdg_cache = os.environ.get("XDG_CACHE_DIR")
    if not xdg_cache:
        raise RuntimeError("XDG_CACHE_DIR is not set")
    path = Path(xdg_cache) / "mail-sync"
    path.mkdir(parents=True, exist_ok=True)
    return path


def muhome_arg():
    xdg_cache = os.environ.get("XDG_CACHE_DIR")
    if not xdg_cache:
        raise RuntimeError("XDG_CACHE_DIR is not set")
    muhome = str(Path(xdg_cache) / "mu")
    return ["--muhome", muhome]


def load_last_run():
    last_run_path = cache_dir() / "last-run"
    try:
        raw = last_run_path.read_text().strip()
    except FileNotFoundError:
        return None
    if not raw:
        return None
    try:
        return datetime.fromisoformat(raw)
    except ValueError:
        return None


def write_last_run(ts):
    cache = cache_dir()
    (cache / "last-run").write_text(ts.isoformat(timespec="seconds"))


def fetch_messages(start, end):
    query = "(maildir:/uu/Inbox OR maildir:/gmail/Inbox)"
    if start is not None:
        start_str = (start - timedelta(seconds=1)).isoformat(timespec="seconds")
        end_str = end.isoformat(timespec="seconds")
        # A delayed download can have an old Date header.
        query += f" AND flag:unread AND changed:{start_str}..{end_str}"
    result = subprocess.run(
        [MU, "find", "--format=json", "--sortfield=date", "--reverse"]
        + muhome_arg()
        + [query],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode == 2:  # mu: no matches
        return []
    if result.returncode != 0:
        print(f"mail-notify: mu find exited {result.returncode}", file=sys.stderr)
        if result.stderr:
            print(result.stderr, file=sys.stderr, end="")
        return None
    raw = result.stdout.strip()
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as error:
        print(f"mail-notify: invalid JSON from mu: {error}", file=sys.stderr)
        return None
    if isinstance(data, dict):
        for key in ("results", "messages", "items"):
            if key in data and isinstance(data[key], list):
                return data[key]
        return []
    if isinstance(data, list):
        return data
    return []


def trim(text, limit):
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 3)] + "..."


def group_key(text):
    return text.replace(" ", "_").replace(":", "-").replace("/", "-")


def format_sender(msg):
    sender = msg.get(":from") or msg.get("from") or msg.get("from_") or ""
    if isinstance(sender, list) and sender:
        sender = sender[0]
    if isinstance(sender, dict):
        name = sender.get(":name") or sender.get("name") or ""
        email = sender.get(":email") or sender.get("email") or sender.get("address") or ""
        return name or email or ""
    if isinstance(sender, str):
        name, email = parseaddr(sender)
        return name or email or ""
    return ""


def message_account(msg):
    path = str(msg.get(":path") or msg.get("path") or "")
    maildir = msg.get(":maildir") or msg.get("maildir") or ""
    return next((name for name in ("uu", "gmail")
                 if maildir == f"/{name}/Inbox"
                 or Path(path).parent.parent == Path.home() / ".mail" / name / "Inbox"), None)


def notification_key(msg):
    account = message_account(msg)
    message_id = str(msg.get(":message-id") or msg.get("message-id") or "")
    if account and message_id:
        return hashlib.sha256((account + "\0" + message_id).encode()).hexdigest()
    return None


def notify(messages):
    sent = set()
    for msg in messages:
        path = str(msg.get(":path") or msg.get("path") or "")
        account = message_account(msg)
        message_id = str(msg.get(":message-id") or msg.get("message-id") or "")
        key = notification_key(msg)
        if key is None or key in sent:
            continue
        sender = trim(format_sender(msg) or "Unknown sender", 48)
        subject = trim(msg.get(":subject") or msg.get("subject") or "(no subject)", 140)
        group = group_key(account + "-" + message_id)
        icon = ASSETS / ("gmail_icon.png" if account == "gmail" else "work_icon.png")
        cmd = [
            TERMINAL_NOTIFIER,
            "-title",
            "Gmail" if account == "gmail" else "Work mail",
            "-subtitle",
            # NSUserDefaults parses leading punctuation as a property list.
            # terminal-notifier removes this escape before displaying the text.
            "\\" + sender,
            "-message",
            "\\" + subject,
            "-group",
            group,
            "-execute",
            shlex.join([
                OPEN_MAIL,
                "--message-id", message_id, "--path", path, "--group", group,
            ]),
        ]
        if icon.exists():
            cmd += ["-contentImage", str(icon)]
        result = subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            sent.add(key)
        else:
            print(f"mail-notify: terminal-notifier exited {result.returncode} ({account})",
                  file=sys.stderr)
        if result.stderr and (DEBUG or result.returncode != 0):
            print(result.stderr, file=sys.stderr, end="")
    return sent


def main():
    now = datetime.now().replace(microsecond=0)
    ledger = cache_dir() / "notified.json"
    if not ledger.exists():
        # Establish a baseline from mail already on disk, without an alert flood.
        messages = fetch_messages(None, None)
        if messages is None:
            return 1
        known = {key for msg in messages if (key := notification_key(msg))}
        save_notified(ledger, known)
        write_last_run(now)
        return 0
    known = set(json.loads(ledger.read_text()))
    last = load_last_run()
    if last is None:
        last = now.replace(hour=0, minute=0, second=0)
    if last > now:
        last = now
    messages = fetch_messages(last, now)
    if messages is None:
        return 1
    messages = [msg for msg in messages if notification_key(msg) not in known]
    expected = {key for msg in messages if (key := notification_key(msg))}
    sent = notify(messages)
    save_notified(ledger, known | sent)
    if expected - sent:
        return 1
    write_last_run(now)
    return 0


def save_notified(path, keys):
    temporary = path.with_suffix(".tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as output:
        json.dump(sorted(keys), output)
    temporary.replace(path)


if __name__ == "__main__":
    raise SystemExit(main())
