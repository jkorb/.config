{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#abb2bf",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#7f848e"
  },
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#4aa5f0", "bold": true },
  "h1": { "prefix": "# ", "color": "#4aa5f0", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### ", "color": "#42b3c2" },
  "h4": { "prefix": "#### ", "color": "#42b3c2" },
  "h5": { "prefix": "##### ", "color": "#c162de" },
  "h6": { "prefix": "###### ", "color": "#c162de" },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#5c6370", "format": "\n────────────────────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#42b3c2", "underline": true },
  "link_text": { "color": "#42b3c2", "bold": true },
  "image": { "color": "#c162de", "underline": true },
  "image_text": { "color": "#abb2bf", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#d18f52" },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": { "color": "#abb2bf" },
      "error": { "color": "#e05561" },
      "comment": { "color": "#7f848e", "italic": true },
      "comment_preproc": { "color": "#c162de" },
      "keyword": { "color": "#c162de" },
      "keyword_reserved": { "color": "#c162de" },
      "keyword_namespace": { "color": "#c162de" },
      "keyword_type": { "color": "#d18f52" },
      "operator": { "color": "#42b3c2" },
      "punctuation": { "color": "#abb2bf" },
      "name": { "color": "#abb2bf" },
      "name_builtin": { "color": "#d18f52" },
      "name_tag": { "color": "#e05561" },
      "name_attribute": { "color": "#d18f52" },
      "name_class": { "color": "#d18f52" },
      "name_constant": { "color": "#d18f52" },
      "name_decorator": { "color": "#4aa5f0" },
      "name_function": { "color": "#4aa5f0" },
      "literal_number": { "color": "#d18f52" },
      "literal_string": { "color": "#8cc265" },
      "literal_string_escape": { "color": "#42b3c2" },
      "generic_deleted": { "color": "#e05561" },
      "generic_inserted": { "color": "#8cc265" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#4aa5f0", "bold": true }
    }
  },
  "definition_description": { "block_prefix": "\n→ " }
}
