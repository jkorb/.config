#!/bin/zsh
# Glow renders; less pages; Plannotator attaches comments to selected text.
set -eo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/glow"

markdown() {
  MD_READ_WIDTH=$width pandoc --quiet \
    --from=gfm+tex_math_dollars+wikilinks_title_after_pipe --to=gfm --wrap=none \
    --lua-filter="$config_dir/wikilinks.lua" \
    --lua-filter="$config_dir/terminal-math.lua" -- "$@" |
    GLOW_PAGER=false GLOW_TUI=false "${renderer[@]}" -
}

render() {
  local -a terminal_size=($(stty size < /dev/tty))
  local -i columns=${terminal_size[2]:-80}
  (( columns > 0 )) || columns=80
  local -i width=$(( columns < 80 ? columns : 80 ))
  local -i padding=$(( (columns - width) / 2 ))
  # Explicit style keeps colors when rendering to a file.
  local -a renderer=(glow --width "$width" --style "$config_dir/onedark.json")
  local feedback
  feedback=$(plannotator-tui --export "$MD_READ_SOURCE")
  print -rn -- $'\e]8;;md-reader:header\a\e]8;;\a'
  python3 "$config_dir/scripts/reader-prompt" --header md
  {
    print -rn -- $'\e]8;;md-reader:source\a\e]8;;\a'
    markdown "$MD_READ_SOURCE"
    if [[ -n $feedback && $feedback != 'No annotations.' ]]; then
      print -rn -- $'\e]8;;md-reader:comments\a\e]8;;\a'
      print -r -- $'\n---\n'"$feedback" |
        markdown -
    fi
    if [[ -f $MD_READ_NOTES ]]; then
      print -rn -- $'\e]8;;md-reader:notes\a\e]8;;\a'
      {
        print -r -- $'\n---\n# Reading notes\n'
        cat -- "$MD_READ_NOTES"
      } | markdown -
    fi
  } | awk -v padding="$padding" '{ printf "%*s%s\n", padding, "", $0 }'
}

case $1 in
  --annotate|--notes|--edit|--links|--refresh)
    [[ -n $MD_READ_SOURCE && -n $MD_READ_RENDERED ]] || exit 1
    source_line=1
    if [[ $1 = --annotate || $1 = --edit || $1 = --notes ]]; then
      target=$MD_READ_SOURCE
      section=source
      if [[ $1 = --notes ]]; then
        target=$MD_READ_NOTES
        section=notes
      fi
      # less's top position includes the body row replaced by the header.
      top_line=${2:-1}
      [[ $top_line != <-> ]] || (( top_line += 1 ))
      source_line=$(python3 "$config_dir/scripts/md-position" \
        "$target" "$MD_READ_RENDERED" "$top_line" "$section")
    fi
    if [[ $1 = --annotate ]]; then
      python3 "$config_dir/scripts/md-annotate" "$MD_READ_SOURCE" "$source_line"
    elif [[ $1 = --notes ]]; then
      nvim "+$source_line" -- "$MD_READ_NOTES"
    elif [[ $1 = --edit ]]; then
      nvim "+$source_line" -- "$MD_READ_SOURCE"
    elif [[ $1 = --links ]]; then
      python3 "$config_dir/scripts/md-links" "$MD_READ_SOURCE" "$MD_READ_NOTES"
    fi
    # Keep the old view if rendering fails, and the inode so less can reread it.
    render > "$MD_READ_RENDERED.next"
    cat -- "$MD_READ_RENDERED.next" > "$MD_READ_RENDERED"
    exit
    ;;
esac

if [[ $# != 1 || ! -f $1 ]]; then
  print -u2 'Usage: md-read FILE.md'
  exit 1
fi

export MD_READ_SOURCE=${1:a}
export READER_TRAIL=$(python3 "$config_dir/scripts/reader-prompt" --push "$MD_READ_SOURCE")
export MD_READ_NOTES="${MD_READ_SOURCE:r}.notes.md"
export MD_READ_COMMAND=${0:a}
export MD_READ_HINTS="$config_dir/scripts/md-hints"
reader_tmp=$(mktemp -d "${TMPDIR:-/tmp}/md-read.XXXXXX")
trap 'rm -rf -- "$reader_tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export MD_READ_RENDERED="$reader_tmp/document.ansi"

render > "$MD_READ_RENDERED"
# Apple's UNIX2003 compatibility table overrides the custom s binding.
# Nerd Font icons live in Unicode's private-use area, which less otherwise
# displays as <U+...>. Keep this setting local to the reader.
LESSUTFCHARDEF="${LESSUTFCHARDEF:+$LESSUTFCHARDEF,}E000-F8FF:p" \
COMMAND_MODE=legacy less -R -~ --header=1 --lesskey-src="$config_dir/lesskeys" \
  --prompt="$(python3 "$config_dir/scripts/reader-prompt" md)" \
  -- "$MD_READ_RENDERED"
