#!/usr/bin/env python3
"""Find the source passage at the top of a rendered Markdown screen."""

from bisect import bisect_left
from difflib import SequenceMatcher
from pathlib import Path
import re
import sys


ANSI = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b\[[0-?]*[ -/]*[@-~]")
SECTION = re.compile(r"\x1b]8;;md-reader:(header|source|comments|notes)\x07")


def tokens(lines):
    words, numbers = [], []
    for number, line in enumerate(lines, 1):
        for match in re.finditer(r"\w+", ANSI.sub("", line).casefold()):
            words.append(match.group())
            numbers.append(number)
    return words, numbers


def source_line(source, rendered, top):
    """Align words in document order, preserving repeated-passage context."""
    original = source.splitlines()
    left, source_lines = tokens(original)
    right, rendered_lines = tokens(rendered)
    if not left or not right:
        return 1
    target = bisect_left(rendered_lines, top)
    previous = 0
    for match in SequenceMatcher(None, left, right).get_matching_blocks():
        if match.b <= target < match.b + match.size:
            return source_lines[match.a + target - match.b]
        if match.b > target:
            # A transformed formula has no matching words. Use the beginning
            # of the unmatched source passage, not the following heading.
            line = source_lines[previous - 1] + 1 if previous else 1
            last = source_lines[match.a] if match.a < len(left) else len(original)
            while line < last and not original[line - 1].strip():
                line += 1
            return min(line, max(1, len(original)))
        previous = match.a + match.size
    return max(1, len(original))


def locate(source, rendered, top, section="source"):
    parts = {"header": [], "source": [], "comments": [], "notes": []}
    starts = {"source": 1}
    current = "source"
    for number, line in enumerate(rendered.splitlines(), 1):
        marker = SECTION.search(line)
        if marker:
            current = marker.group(1)
            starts[current] = number
        parts[current].append(line)
    if section not in starts:
        return 1
    local_top = max(1, min(top - starts[section] + 1, len(parts[section]) + 1))
    return source_line(source, parts[section], local_top)


if __name__ == "__main__":
    source, rendered, top, section = sys.argv[1:]
    path = Path(source)
    print(locate(path.read_text() if path.exists() else "", Path(rendered).read_text(),
                 int(top) if top.isdigit() else 1, section))
