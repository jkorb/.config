# autoload

fzf-goto-dir-widget () {
  setopt localoptions pipefail no_aliases 2> /dev/null
  zle -I
  local target
  target=$("$XDG_CONFIG_HOME/zsh/scripts/fzf-goto-dir")
  if [[ -z "$target" ]]; then
    zle redisplay
    return 0
  fi
  zle push-line # Clear buffer. Auto-restored on next prompt.
  BUFFER="cd -- ${(q)target:a}"
  zle accept-line
  local ret=$?
  zle reset-prompt
  return $ret
}

fzf-goto-dir-widget
