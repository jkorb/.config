# Generated by theme-build. Edit themes/palette.json or themes/templates instead.
# Loaded after plugins so their defaults cannot replace these colors.
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS
  --color=bg:-1,fg:#abb2bf,hl:#42b3c2
  --color=bg+:#30363f,fg+:#d7dae0,hl+:#42b3c2
  --color=preview-bg:-1,preview-fg:#abb2bf,border:#3f4451
  --color=prompt:#4aa5f0,spinner:#42b3c2,info:#7f848e,header:#7f848e
  --color=pointer:#4aa5f0,marker:#8cc265,label:#4aa5f0"

export NNN_COLORS='4123'
# Device, device, directory, executable, regular, hardlink, symlink, details,
# broken link, FIFO, socket, unknown. 00 means terminal default in nnn.
export NNN_FCOLORS='030304020005060801030501'
export LS_COLORS='di=01;34:ln=36:ex=32:fi=0:pi=33:so=35:bd=33:cd=33:or=01;31:mi=01;31:*.tar=31:*.gz=31:*.zip=31:*.pdf=35:*.md=36'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#7f848e'
ZSH_HIGHLIGHT_STYLES[default]='none'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#e05561'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#c162de'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[function]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[command]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[path]='fg=#42b3c2'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#8cc265'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#c162de'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#c162de'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=#4aa5f0'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=#c162de'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=#42b3c2'
zstyle ':prompt:pure:path' color '#4aa5f0'
zstyle ':prompt:pure:prompt:success' color '#4aa5f0'
zstyle ':prompt:pure:prompt:error' color '#e05561'
zstyle ':prompt:pure:git:branch' color '#7f848e'
zstyle ':prompt:pure:git:dirty' color '#d18f52'
zstyle ':prompt:pure:git:arrow' color '#42b3c2'
zstyle ':prompt:pure:git:stash' color '#c162de'
zstyle ':prompt:pure:execution_time' color '#d18f52'
zstyle ':prompt:pure:user' color '#abb2bf'
zstyle ':prompt:pure:user:root' color '#e05561'
zstyle ':prompt:pure:host' color '#7f848e'
