#!/usr/bin/env python3
"""Render native theme files using only the Python standard library."""

import argparse
import difflib
import json
import os
from pathlib import Path
import plistlib
import re
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[2]
TOKEN = re.compile(r"@@([a-z][a-z0-9_]*)(?:\.(rgb|ansi|ansi_hex))?@@")
ANSI = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
ANSI += ["bright_" + name for name in ANSI]


def read_json(path):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"{path}: duplicate key {key}")
            result[key] = value
        return result
    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique)


def palette(path):
    data = read_json(path)
    if set(data) != {"version", "name", "colors", "roles", "ansi"} or data["version"] != 1:
        raise ValueError("palette must use schema version 1 and its five documented fields")
    colors, roles, ansi = data["colors"], data["roles"], data["ansi"]
    if not isinstance(data["name"], str) or not isinstance(colors, dict) or not isinstance(roles, dict):
        raise ValueError("invalid palette name, colors or roles")
    for key, value in colors.items():
        if not re.fullmatch(r"[a-z][a-z0-9_]*", key) or not isinstance(value, str) or not re.fullmatch(r"#[0-9a-f]{6}", value):
            raise ValueError(f"invalid color {key}: use lowercase #rrggbb")
    for key, value in roles.items():
        if not re.fullmatch(r"[a-z][a-z0-9_]*", key) or key in colors or value not in colors:
            raise ValueError(f"invalid role {key}: reference a color, without shadowing its name")
    if ansi != ANSI or any(c not in colors for c in ANSI):
        raise ValueError("ansi must list the standard 16 color names in terminal slot order")
    return colors, roles, ansi


def render(source, colors, roles, ansi):
    def replace(match):
        key, fmt = match.groups()
        key = roles.get(key, key)
        if key not in colors:
            raise ValueError(f"unknown color token {match[0]}")
        value = colors[key]
        if fmt == "rgb":
            return ",".join(str(int(value[i:i + 2], 16)) for i in (1, 3, 5))
        if fmt in ("ansi", "ansi_hex"):
            if key not in ansi:
                raise ValueError(f"{key} has no ANSI slot")
            index = ansi.index(key)
            return f"{index:02x}" if fmt == "ansi_hex" else str(index)
        return value
    result = TOKEN.sub(replace, source)
    if "@@" in result:
        raise ValueError("malformed or unresolved template token")
    return result


def inside(root, relative):
    path = Path(relative)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        raise ValueError(f"unsafe path: {relative}")
    target = root / path
    # Refuse links rather than replacing them or writing through them.
    if any(p.is_symlink() for p in [target, *target.parents] if p != root and root in p.parents):
        raise ValueError(f"symlink in output path: {relative}")
    if not target.resolve().is_relative_to(root.resolve()):
        raise ValueError(f"path escapes root: {relative}")
    return target


def plan(root, theme_dir):
    colors, roles, ansi = palette(theme_dir / "palette.json")
    outputs = []
    seen = set()
    for entry in read_json(theme_dir / "targets.json"):
        if set(entry) - {"template", "target", "block"} or not {"template", "target"} <= set(entry):
            raise ValueError("invalid target entry")
        target = inside(root, entry["target"])
        if target in seen:
            raise ValueError(f"duplicate target: {target}")
        seen.add(target)
        template = inside(theme_dir / "templates", entry["template"])
        result = render(template.read_text(encoding="utf-8"), colors, roles, ansi)
        old = target.read_text(encoding="utf-8") if target.exists() else ""
        if "block" in entry:
            start = f'# BEGIN GENERATED THEME: {entry["block"]}\n'
            end = f'# END GENERATED THEME: {entry["block"]}\n'
            if old.count(start) != 1 or old.count(end) != 1 or old.index(start) > old.index(end):
                raise ValueError(f"{target}: expected exactly one ordered theme block")
            result = old[:old.index(start) + len(start)] + result + old[old.index(end):]
        if target.suffix == ".json":
            json.loads(result)
        if target.suffix == ".tmTheme":
            plistlib.loads(result.encode())
        outputs.append((target, old, result))
    return outputs


def write_atomic(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    fd, temp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="report stale files without writing; exit 1 on drift")
    mode.add_argument("--diff", action="store_true", help="show proposed changes without writing")
    parser.add_argument("--root", type=Path, default=ROOT, help="config checkout to build (default: this script's checkout)")
    args = parser.parse_args()
    root = args.root.resolve()
    try:
        outputs = plan(root, root / "themes")  # Validate every input before any writes.
        changed = [(p, a, b) for p, a, b in outputs if a != b]
        for path, old, new in changed:
            label = str(path.relative_to(root))
            if args.diff:
                print("".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True), fromfile=label, tofile=label)), end="")
            elif args.check:
                print(f"stale: {label}")
            else:
                write_atomic(path, new)
                print(f"updated: {label}")
        if args.check or args.diff:
            if not changed:
                print(f"Theme is current ({len(outputs)} files).")
            return int(bool(changed))
        print(f"Theme built ({len(changed)} changed, {len(outputs)} files).")
        if any(p.suffix == ".tmTheme" and "bat" in p.parts for p, _, _ in changed):
            print("Run bat cache --build to refresh bat's compiled themes.")
        return 0
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"theme-build: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
