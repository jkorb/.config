# Generated by theme-build. Edit themes/palette.json or themes/templates instead.
# ncurses under tmux-256color needs terminal palette slots, not RGB literals.
set color_directcolor = no
set header_color_partial
uncolor *

color normal default default
color indicator color@@white.ansi@@ color@@black.ansi@@
color index default default ~A
color index bold color@@blue.ansi@@ default ~U
color index color@@green.ansi@@ default ~Q
color index color@@yellow.ansi@@ default ~T
color index color@@red.ansi@@ default ~D
color index_author default default ~A
color index_subject default default ~A
color index_date color@@bright_black.ansi@@ default ~A
color index_author bold color@@blue.ansi@@ default ~U
color index_author color@@green.ansi@@ default ~Q
color index_author color@@yellow.ansi@@ default ~T
color index_author color@@red.ansi@@ default ~D
color index_subject bold color@@white.ansi@@ default ~U
color index_subject color@@green.ansi@@ default ~Q
color index_subject color@@yellow.ansi@@ default ~T
color index_subject color@@red.ansi@@ default ~D
color tree color@@bright_black.ansi@@ default

color status color@@bright_black.ansi@@ default
color status bold color@@cyan.ansi@@ default '(|)'
color status color@@blue.ansi@@ default '(From|Subject|Date)'
color error color@@error.ansi@@ default
color message color@@green.ansi@@ default
color warning color@@yellow.ansi@@ default
color search color@@white.ansi@@ color@@black.ansi@@
color attachment color@@cyan.ansi@@ default
color tilde color@@black.ansi@@ default

color hdrdefault color@@bright_black.ansi@@ default
color header color@@cyan.ansi@@ default "^[ \t]*(Date:|To:|From:|CC:|BCC:|Subject:)"
color signature color@@bright_black.ansi@@ default
color quoted color@@bright_black.ansi@@ default
color quoted1 color@@bright_black.ansi@@ default
color quoted2 color@@bright_black.ansi@@ default
color quoted3 color@@bright_black.ansi@@ default
color quoted4 color@@bright_black.ansi@@ default
color quoted5 color@@bright_black.ansi@@ default
color body color@@cyan.ansi@@ default "(https?|ftp)://[^[:space:]<>]+"
color body color@@cyan.ansi@@ default "[[:alnum:]._%+-]+@[[:alnum:].-]+"
color body color@@green.ansi@@ default "\`[^\`]+\`"
color body bold color@@white.ansi@@ default "^[ \t]*#{1,6} "
color body color@@red.ansi@@ default "(BAD signature)"
color body color@@green.ansi@@ default "(Good signature)"
color body color@@bright_black.ansi@@ default "^[ \t]*gpg: "

color sidebar_background default default
color sidebar_indicator bold color@@white.ansi@@ color@@black.ansi@@
color sidebar_highlight color@@white.ansi@@ color@@black.ansi@@
color sidebar_spoolfile color@@blue.ansi@@ default
color sidebar_new bold color@@blue.ansi@@ default
color sidebar_unread color@@blue.ansi@@ default
color sidebar_ordinary default default
color sidebar_flagged color@@yellow.ansi@@ default
color sidebar_divider color@@black.ansi@@ default
