# Generated by theme-build. Edit themes/palette.json or themes/templates instead.
# Loaded after plugins so their defaults cannot replace these colors.
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS
  --color=bg:-1,fg:@@foreground@@,hl:@@magenta@@
  --color=bg+:@@selection_bg@@,fg+:@@selection_fg@@,hl+:@@selection_fg@@
  --color=preview-bg:-1,preview-fg:@@foreground@@,border:@@border@@
  --color=prompt:@@accent@@,spinner:@@cyan@@,info:@@comment@@,header:@@yellow@@"

export NNN_COLORS='@@blue.ansi@@@@red.ansi@@@@green.ansi@@@@yellow.ansi@@'
# Device, device, directory, executable, regular, hardlink, symlink, details,
# broken link, FIFO, socket, unknown. 00 means terminal default in nnn.
export NNN_FCOLORS='@@yellow.ansi_hex@@@@yellow.ansi_hex@@@@blue.ansi_hex@@@@green.ansi_hex@@00@@magenta.ansi_hex@@@@cyan.ansi_hex@@@@bright_black.ansi_hex@@@@red.ansi_hex@@@@yellow.ansi_hex@@@@magenta.ansi_hex@@@@red.ansi_hex@@'
export LS_COLORS='di=01;34:ln=36:ex=32:fi=0:pi=33:so=35:bd=33:cd=33:or=01;31:mi=01;31:*.tar=31:*.gz=31:*.zip=31:*.pdf=35:*.md=36'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=@@comment@@'
ZSH_HIGHLIGHT_STYLES[default]='none'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=@@error@@'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=@@keyword@@'
ZSH_HIGHLIGHT_STYLES[alias]='fg=@@success@@'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=@@success@@'
ZSH_HIGHLIGHT_STYLES[function]='fg=@@success@@'
ZSH_HIGHLIGHT_STYLES[command]='fg=@@success@@'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=@@success@@'
ZSH_HIGHLIGHT_STYLES[path]='fg=@@link@@'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=@@string@@'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=@@string@@'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=@@string@@'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=@@keyword@@'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=@@keyword@@'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=@@blue@@'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=@@magenta@@'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=@@cyan@@'
zstyle ':prompt:pure:path' color '@@accent@@'
zstyle ':prompt:pure:prompt:success' color '@@accent@@'
zstyle ':prompt:pure:prompt:error' color '@@error@@'
zstyle ':prompt:pure:git:branch' color '@@comment@@'
zstyle ':prompt:pure:git:dirty' color '@@warning@@'
zstyle ':prompt:pure:git:arrow' color '@@cyan@@'
zstyle ':prompt:pure:git:stash' color '@@magenta@@'
zstyle ':prompt:pure:execution_time' color '@@warning@@'
zstyle ':prompt:pure:user' color '@@foreground@@'
zstyle ':prompt:pure:user:root' color '@@error@@'
zstyle ':prompt:pure:host' color '@@comment@@'
