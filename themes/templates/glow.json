{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "@@foreground@@",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "@@comment@@"
  },
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "@@blue@@", "bold": true },
  "h1": { "prefix": "# ", "color": "@@blue@@", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### ", "color": "@@cyan@@" },
  "h4": { "prefix": "#### ", "color": "@@cyan@@" },
  "h5": { "prefix": "##### ", "color": "@@magenta@@" },
  "h6": { "prefix": "###### ", "color": "@@magenta@@" },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "@@muted@@", "format": "\n────────────────────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "@@cyan@@", "underline": true },
  "link_text": { "color": "@@cyan@@", "bold": true },
  "image": { "color": "@@magenta@@", "underline": true },
  "image_text": { "color": "@@foreground@@", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "@@yellow@@" },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": { "color": "@@foreground@@" },
      "error": { "color": "@@red@@" },
      "comment": { "color": "@@comment@@", "italic": true },
      "comment_preproc": { "color": "@@magenta@@" },
      "keyword": { "color": "@@magenta@@" },
      "keyword_reserved": { "color": "@@magenta@@" },
      "keyword_namespace": { "color": "@@magenta@@" },
      "keyword_type": { "color": "@@yellow@@" },
      "operator": { "color": "@@cyan@@" },
      "punctuation": { "color": "@@foreground@@" },
      "name": { "color": "@@foreground@@" },
      "name_builtin": { "color": "@@yellow@@" },
      "name_tag": { "color": "@@red@@" },
      "name_attribute": { "color": "@@yellow@@" },
      "name_class": { "color": "@@yellow@@" },
      "name_constant": { "color": "@@yellow@@" },
      "name_decorator": { "color": "@@blue@@" },
      "name_function": { "color": "@@blue@@" },
      "literal_number": { "color": "@@yellow@@" },
      "literal_string": { "color": "@@green@@" },
      "literal_string_escape": { "color": "@@cyan@@" },
      "generic_deleted": { "color": "@@red@@" },
      "generic_inserted": { "color": "@@green@@" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "@@blue@@", "bold": true }
    }
  },
  "definition_description": { "block_prefix": "\n→ " }
}
