#!/bin/sh
# nnn stays the foreground process-group leader while its plugins/editors run.
# Only translate Ctrl-G when nnn itself is waiting for input (no child process).
ps -o pid=,ppid=,comm= -t "$1" | awk '
  { parents[$2] = 1 }
  $3 ~ /(^|\/)nnn$/ { nnn[$1] = 1 }
  END {
    for (pid in nnn)
      if (!(pid in parents)) exit 0
    exit 1
  }
'
