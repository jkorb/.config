#!/bin/zsh
# nnn's foreground opener: read here, edit with e.
file=$1
[[ $file = /* ]] || file="$PWD/$file"

case ${file:e:l} in
  md|markdown|mdown|mkd|mkdn)
    exec "$XDG_CONFIG_HOME/glow/scripts/md-read" "$file"
    ;;
esac

case $(file --brief --mime-type --dereference -- "$file") in
  image/*)
    exec "$XDG_CONFIG_HOME/chawan/scripts/image-view" "$file"
    ;;
  text/*|application/json|application/xml|application/javascript|application/x-empty|inode/x-empty)
    exec "$XDG_CONFIG_HOME/bat/scripts/bat-read" -- "$file"
    ;;
  *)
    exec /usr/bin/open "$file"
    ;;
esac
