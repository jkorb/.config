IMAPAccount uu
Host 127.0.0.1
Port 2143
AuthMechs LOGIN
PassCmd "pass login.uu.nl | sed -n 's/^pass: //p'"
TLSType None
SystemCertificates yes
#CertificateFile /etc/ssl/certs/ca-certificates.crt
User j.korbmacher@uu.nl
Timeout 120

IMAPStore uu-remote
Account uu

MaildirStore uu-local
SubFolders Verbatim
Path ~/.mail/uu/
Inbox ~/.mail/uu/Inbox

Channel uu-main
Far :uu-remote:
Near :uu-local:
Patterns "INBOX" "Archive" "Drafts" "Junk" "Unsent Messages"
# Retain downloaded mail. All server filing happens in NeoMutt over live IMAP.
Sync Pull New
Create Near
Remove None
Expunge None
SyncState *

# DavMail Graph can advertise Sent twice in LIST; address it explicitly.
Channel uu-sent
Far :uu-remote:Sent
Near :uu-local:Sent
Sync Pull New
Create Near
Remove None
Expunge None
SyncState *

Channel uu-trash
Far :uu-remote:Trash
Near :uu-local:Trash
Sync Pull New
Create Near
Remove None
Expunge None
SyncState *

Group uu
Channel uu-main
Channel uu-sent
Channel uu-trash

IMAPAccount gmail
Host imap.gmail.com
User jkorbmacher@gmail.com
PassCmd "pass accounts.google.com | sed -n 's/^app: //p'"
TLSType IMAPS
AuthMechs PLAIN
SystemCertificates yes
#CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore gmail-remote
Account gmail

MaildirStore gmail-local
SubFolders Verbatim
Path ~/.mail/gmail/
Inbox ~/.mail/gmail/Inbox

Channel gmail-inbox
Far :gmail-remote:
Near :gmail-local:
Patterns "INBOX"
Create Both
Expunge Both
SyncState *

Channel gmail-all
Far :gmail-remote:"[Google Mail]/All Mail"
Near :gmail-local:"All Mail"
Create Near
SyncState *

Channel gmail-sent
Far :gmail-remote:"[Google Mail]/Sent Mail"
Near :gmail-local:"Sent Mail"
Create Near
SyncState *

Channel gmail-drafts
Far :gmail-remote:"[Google Mail]/Drafts"
Near :gmail-local:"Drafts"
Create Near
SyncState *

Channel gmail-spam
Far :gmail-remote:"[Google Mail]/Spam"
Near :gmail-local:"Spam"
Create Near
SyncState *

Channel gmail-trash
Far :gmail-remote:"[Google Mail]/Trash"
Near :gmail-local:"Trash"
Create Near
SyncState *

Group gmail
Channel gmail-inbox
Channel gmail-all
Channel gmail-drafts
Channel gmail-sent
Channel gmail-spam
Channel gmail-trash
