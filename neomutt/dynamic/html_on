# vim: filetype=muttrc
source ~/.config/neomutt/core/settings
source ~/.config/neomutt/core/colors-html

# Reading and quoting are independent; quoted HTML bypasses Markdown conversion.
unset pager
set include=no
set forward_quote=no
set my_mail_keys = "~/.config/neomutt/dynamic/mail_html_keys"
source $my_mail_keys
