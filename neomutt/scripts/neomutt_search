#! /usr/bin/env zsh

cache_dir="${XDG_CACHE_DIR:-$HOME/.cache}/neomutt_search"
search_dir="${MAILDIR:-$HOME/.mail}/recent-search"
export MUHOME="${XDG_CACHE_DIR:-$HOME/.cache}/mu"
search_hist="$cache_dir/search_hist"
tmp_searchfile="$cache_dir/tmp_searchfile"

if [[ ! -d "$cache_dir" ]]; then
  mkdir -p "$cache_dir"
fi

if [[ ! -f "$search_hist" ]]; then
  touch "$search_hist"
fi

: > "$tmp_searchfile"
query=$(sort -u "$search_hist" | fzf --height=100% --prompt ' ' --history="$search_hist" --history-size=10000 --bind=enter:replace-query+print-query,ctrl-s:print-query --preview "mu find --skip-dups --fields \"f s\" {}")

if [[ -z $query ]]; then
  exit 0
fi

# mu clears only result symlinks. Retained copies may share a Message-ID.
mu find -q --skip-dups --clearlinks --format=links --linksdir="$search_dir" "$query"
result=$?
if (( result != 0 && result != 2 )); then
  exit "$result"
fi
if (( result == 2 )); then
  print "No matching mail."
  exit 0
fi

print 'push <change-folder-readonly>~/.mail/recent-search<enter>' > "$tmp_searchfile"
exit 0
