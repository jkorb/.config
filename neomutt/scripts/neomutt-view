#!/usr/bin/python3
"""Read mail in Chawan or Firefox, with mail actions passed back to NeoMutt."""
import argparse
import base64
from email import policy
from email.parser import BytesParser
import hashlib
import html
import json
import mimetypes
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
from urllib.parse import unquote

SELF = Path(__file__).resolve()


def quote(value):
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('`', '\\`').replace('$', '\\$') + '"'


def prepare(firefox=False):
    cache = Path(os.environ.get('XDG_CACHE_DIR', str(Path.home() / '.cache'))) / 'neomutt-view'
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    run = Path(tempfile.mkdtemp(dir=cache))
    options = ('pipe_decode', 'auto_tag', 'wait_key')
    restore = '\n'.join(f'set {key} = "$my_view_{key}"' for key in options) + '\n'
    (run / 'actions.rc').write_text(restore)
    for key in options:
        print(f'set my_view_{key} = "${key}"')
    print('set pipe_decode=no auto_tag=no wait_key=no')
    command = [str(SELF), 'message', str(run)]
    if firefox:
        command.append('--firefox')
    keys = ('<pipe-message>' + shlex.join(command)
            + '<enter><enter-command>source ' + quote(str(run / 'actions.rc')) + '<enter>')
    print('push ' + quote(keys))


def message_html(message, run):
    part = message.get_body(preferencelist=('html', 'plain'))
    if part is None:
        calendar = next((item for item in message.walk() if item.get_content_type() in ('text/calendar', 'application/ics')), None)
        if calendar is None:
            raise ValueError('This message has no displayable body')
        content = subprocess.run([str(SELF.with_name('neomutt-invite')), 'preview'],
                                 input=calendar.get_payload(decode=True) or b'',
                                 capture_output=True, check=True, timeout=10).stdout.decode('utf-8')
        return '<!doctype html><meta charset="utf-8"><pre>' + html.escape(content) + '</pre>'
    content = part.get_content()
    if part.get_content_type() != 'text/html':
        return '<!doctype html><meta charset="utf-8"><pre>' + html.escape(content) + '</pre>'
    # Resolve embedded images for viewing; the original message is untouched.
    resources = {}
    for item in message.walk():
        cid = str(item.get('Content-ID', '')).strip('<>')
        if cid and not item.is_multipart() and item.get_content_maintype() == 'image':
            extension = mimetypes.guess_extension(item.get_content_type()) or ''
            path = run / (hashlib.sha256(cid.encode()).hexdigest() + extension)
            path.write_bytes(item.get_payload(decode=True) or b'')
            resources[cid] = path.as_uri()
    return re.sub(r'cid:([^\s"\'<>]+)',
                  lambda m: resources.get(unquote(m[1]), m[0]), content, flags=re.I)


def open_firefox(path, charset='utf-8'):
    content = path.read_bytes().decode(charset or 'utf-8', errors='replace')
    # Embed only the CID images extracted by message_html, so the browser copy
    # survives the terminal viewer closing and deleting its temporary files.
    for image in path.parent.iterdir():
        if not re.fullmatch(r'[0-9a-f]{64}\.[a-zA-Z0-9]+', image.name):
            continue
        mime = mimetypes.guess_type(image.name)[0] or ''
        if mime.startswith('image/') and image.is_file() and not image.is_symlink():
            uris = {image.absolute().as_uri(), image.resolve().as_uri()}
            if any(uri in content for uri in uris):
                data = base64.b64encode(image.read_bytes()).decode('ascii')
                for uri in uris:
                    content = content.replace(uri, f'data:{mime};base64,{data}')
    # Display email HTML without giving it scripts, forms or embedded frames.
    policy = ("default-src 'none'; img-src data: https: http:; "
              "style-src 'unsafe-inline' https: http:; font-src data: https: http:; "
              "base-uri 'none'; form-action 'none'")
    content = ('<!doctype html><meta charset="utf-8">'
               '<meta http-equiv="Content-Security-Policy" content="' + html.escape(policy, quote=True)
               + '">' + content)
    cache = Path(os.environ.get('XDG_CACHE_DIR', str(Path.home() / '.cache'))) / 'neomutt-browser'
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    encoded = content.encode('utf-8')
    target = cache / (hashlib.sha256(encoded).hexdigest() + '.html')
    if not target.exists():
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as output:
            output.write(encoded)
    subprocess.run(['open', '-a', 'Firefox', target.as_uri()], check=True)


def view(path, run=None, charset='utf-8'):
    command = ['cha', '-o', 'network.allow-http-from-file=true',
               '-o', 'buffer.history=false', '-I', charset or 'utf-8', '-T', 'text/html']
    style = SELF.parents[2] / 'chawan/mail.css'
    command += ['-o', 'buffer.user-style=' + json.dumps(style.read_text())]
    command += ['-o', 'start.startup-script=' + json.dumps(str(style.with_name('mail.js')))]
    env = os.environ.copy()
    env['NEOMUTT_VIEW_PATH'] = str(path.resolve())
    browser_command = shlex.quote(str(SELF)) + ' firefox "$NEOMUTT_VIEW_PATH" "$CHA_CHARSET"'
    browser_js = '() => pager.extern(' + json.dumps(browser_command) + ', {suspend: false})'
    command += ['-o', 'page.B=' + json.dumps(browser_js)]
    if run:
        env['NEOMUTT_VIEW_ACTION'] = str(run / 'action')
        actions = [('A', 'attachments'), ('H', 'text')]
        actions += [(' '.join(key), key) for key in ('cr', 'ca', 'cc', 'cf', 'ci', 'sa', 'si', 'sj', 'ss')]
        if env.get('NEOMUTT_NOTIFICATION') == '1':
            actions.append(('q', 'quit'))
        for key, action in actions:
            js = '() => { writeFile(getenv("NEOMUTT_VIEW_ACTION"), "' + action + '"); quit(); }'
            command += ['-o', 'page.' + json.dumps(key) + '=' + json.dumps(js)]
    else:
        # A MIME part opened from the attachment list already returns there.
        command += ['-o', 'page.A=quit']
    command.append(str(path))
    with open('/dev/tty', 'r+b', buffering=0) as terminal:
        subprocess.run(command, stdin=terminal, stdout=terminal, stderr=terminal, env=env, check=True)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['prepare', 'message', 'part', 'firefox'])
    parser.add_argument('path', nargs='?', type=Path)
    parser.add_argument('charset', nargs='?', default='utf-8')
    parser.add_argument('--firefox', action='store_true')
    args = parser.parse_args()
    if args.action == 'prepare':
        prepare(args.firefox)
    elif args.action == 'firefox':
        open_firefox(args.path, args.charset)
    elif args.action == 'part':
        view(args.path, charset=args.charset)
    else:
        run = args.path
        message = BytesParser(policy=policy.default).parse(sys.stdin.buffer)
        with tempfile.TemporaryDirectory(prefix='view-', dir=run) as temporary:
            assets = Path(temporary)
            path = assets / 'message.html'
            path.write_text(message_html(message, assets), encoding='utf-8')
            if args.firefox:
                open_firefox(path)
            else:
                view(path, run)
        action = (run / 'action').read_text() if (run / 'action').exists() else ''
        keys = {'attachments': '<view-attachments>', 'text': '<display-message>', 'quit': 'q'}.get(action)
        if action in ('cr', 'ca', 'cc', 'cf', 'ci', 'sa', 'si', 'sj', 'ss'):
            keys = action
        if keys:
            with (run / 'actions.rc').open('a') as output:
                if action in ('cr', 'ca'):
                    output.write('source "~/.config/neomutt/dynamic/html_on"\n')
                    kind = 'reply' if action == 'cr' else 'group-reply'
                    command = shlex.join([str(SELF.with_name('neomutt-html')), 'start', kind])
                    # Invoke HTML composition directly: the underlying menu
                    # may be the text pager, whose reply keys select text mode.
                    keys = '<enter-command>source ' + quote(command + ' |') + '<enter>'
                output.write('push ' + quote(keys) + '\n')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('Mail viewer: ' + str(error), file=sys.stderr)
        raise SystemExit(1)
