# vim: filetype=mailcap
# 
# MS Word documents
application/msword; open %s &
application/vnd.ms-excel; open %s &
application/vnd.openxmlformats-officedocument.presentationml.presentation; open %s &
application/vnd.oasis.opendocument.text; open %s &
application/vnd.openxmlformats-officedocument.wordprocessingml.document; open %s &
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet; open %s &

# HTML
# Interactive HTML viewing loads remote images; text rendering uses w3m.
text/html; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-view part %s %{charset}; needsterminal; nametemplate=%s.html
text/html; w3m -o display_link_number=1 -I %{charset} -T text/html; copiousoutput;
text/plain; nvim %s
text/markdown; nvim %s 

# Calendar previews; ci on the message opens the response dialog.
text/calendar; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-invite preview %s; copiousoutput
application/ics; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-invite preview %s; copiousoutput

#PDFs
application/pdf; open %s &

#Images
image/*; $XDG_CONFIG_HOME/chawan/scripts/image-view %s; needsterminal

# Rest
application/octet-stream; open %s &
