# vim: filetype=mailcap
#
# MS Word documents
application/msword; /usr/bin/libreoffice %s &
application/vnd.ms-excel; /usr/bin/libreoffice %s &
application/vnd.openxmlformats-officedocument.presentationml.presentation; /usr/bin/libreoffice %s &
application/vnd.oasis.opendocument.text; /usr/bin/libreoffice %s &
application/vnd.openxmlformats-officedocument.wordprocessingml.document; /usr/bin/libreoffice %s &
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet; /usr/bin/libreoffice %s &

# HTML
text/html; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-view part %s %{charset}; needsterminal; nametemplate=%s.html
text/html; $XDG_CONFIG_HOME/neomutt/scripts/mail-display html %{charset}; copiousoutput;
# text/html; pandoc -f html -t markdown_strict; copiousoutput;

# w3m -o display_link_number=1 -I %{charset} -T text/html

# text/html; w3m -o display_link_number=1 -I %{charset} -T text/html; copiousoutput;
text/plain; nvr %s
text/markdown; nvr %s 

# Calendar previews; ci on the message opens the response dialog.
text/calendar; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-invite preview %s; copiousoutput
application/ics; $XDG_CONFIG_HOME/neomutt/scripts/neomutt-invite preview %s; copiousoutput

#PDFs
application/pdf; /usr/bin/zathura %s &

#Images
image/png; /usr/bin/imv %s &
image/jpeg; /usr/bin/imv %s &
# image/*; anytopnm %s | pnmscale -xsize 80 -ysize 50 | ppmtopgm | pgmtopbm | pbmtoascii ; copiousoutput
