# Generated by theme-build. Edit themes/palette.json or themes/templates instead.
# ncurses under tmux-256color needs terminal palette slots, not RGB literals.
set color_directcolor = no
set header_color_partial
uncolor *

color normal default default
color indicator color7 color0
color index default default ~A
color index bold color4 default ~U
color index color2 default ~Q
color index color3 default ~T
color index color1 default ~D
color index_author default default ~A
color index_subject default default ~A
color index_date color8 default ~A
color index_author bold color4 default ~U
color index_author color2 default ~Q
color index_author color3 default ~T
color index_author color1 default ~D
color index_subject bold color7 default ~U
color index_subject color2 default ~Q
color index_subject color3 default ~T
color index_subject color1 default ~D
color tree color8 default

color status color8 default
color status bold color6 default '(|)'
color status color4 default '(From|Subject|Date)'
color error color1 default
color message color2 default
color warning color3 default
color search color7 color0
color attachment color6 default
color tilde color0 default

color hdrdefault color8 default
color header color6 default "^[ \t]*(Date:|To:|From:|CC:|BCC:|Subject:)"
color signature color8 default
color quoted color8 default
color quoted1 color8 default
color quoted2 color8 default
color quoted3 color8 default
color quoted4 color8 default
color quoted5 color8 default
color body color6 default "(https?|ftp)://[^[:space:]<>]+"
color body color6 default "[[:alnum:]._%+-]+@[[:alnum:].-]+"
color body color2 default "\`[^\`]+\`"
color body bold color7 default "^[ \t]*#{1,6} "
color body color1 default "(BAD signature)"
color body color2 default "(Good signature)"
color body color8 default "^[ \t]*gpg: "

color sidebar_background default default
color sidebar_indicator bold color7 color0
color sidebar_highlight color7 color0
color sidebar_spoolfile color4 default
color sidebar_new bold color4 default
color sidebar_unread color4 default
color sidebar_ordinary default default
color sidebar_flagged color3 default
color sidebar_divider color0 default
