map b toggle_statusbar
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen

map <C-r> feedkeys "ir"

set adjust-open "best-fit"

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 40

# zoom settings
set zoom-min 10
set guioptions ""

set font "ComicShannsMono Nerd Font"

set database "sqlite"

set selection-clipboard clipboard

set recolor                     false
set recolor-keephue             false      # keep original color

set synctex                     true
set synctex-editor-command      'zathura-inverse "%{input}" "%{line}"'
map <C-t> exec 'zathura-return "$FILE" "$PAGE" "$DBUS"'

# Theme controls colors only; recolor remains off until explicitly toggled.
include theme
set render-loading true
