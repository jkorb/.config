[general]
status_path = "~/.config/vdirsyncer/status/"

[pair uu_graph]
a = "uu_graph_local"
b = "uu_graph_remote"
collections = ["calendar"]
conflict_resolution = "b wins"


[storage uu_graph_local]
type = "filesystem"
path = "~/.local/share/khal/calendars/uu-graph/"
fileext = ".ics"

[storage uu_graph_remote]
type = "caldav"
url = "http://127.0.0.1:2080/users/j.korbmacher@uu.nl/calendar/"
username = "j.korbmacher@uu.nl"
password.fetch = ["shell", "/Users/jkorbmacher/.config/vdirsyncer/scripts/fetch-pw.zsh"]
